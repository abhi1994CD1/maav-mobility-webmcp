# Browser-exposed Maps JavaScript API key. Restrict by allowed HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional map ID for AdvancedMarkerElement. The app uses DEMO_MAP_ID when omitted.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Server-only Routes API key. Restrict to Routes API and never expose to the browser.
GOOGLE_ROUTES_API_KEY=
